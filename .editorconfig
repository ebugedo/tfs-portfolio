root = true

[*.{cs,csproj,slnx,props,targets}]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# === C# Style Preferences (aligned with StyleCop) ===

# 'var' usage
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true:suggestion

# Expression-bodied members (SA1503, SA1513 - braces not omitted)
csharp_prefer_simple_default_expression = true
csharp_prefer_simple_using_statement = true
csharp_prefer_implicit_object_creation_when_type_is_apparent = true
csharp_prefer_pattern_matching = true
csharp_prefer_null_check_over_type_check = true
csharp_prefer_is_null_check_over_reference_equality = true
csharp_prefer_conditional_expression_over_assignment = true
csharp_prefer_conditional_expression_over_return = true
csharp_prefer_expression_bodied_operators = true
csharp_prefer_expression_bodied_properties = true
csharp_prefer_expression_bodied_methods = true
csharp_prefer_expression_bodied_constructors = true
csharp_prefer_expression_bodied_lambdas = true
csharp_prefer_expression_bodied_accessors = true
csharp_prefer_braces = true

# Null handling (aligns with nullable enable)
dotnet_style_null_propagation = true
dotnet_style_coalesce_expression = true

# Initializers
dotnet_style_object_initializer = true
dotnet_style_collection_initializer = true

# Type preferences
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true

# Modern syntax
csharp_style_throw_expression = true
csharp_style_deconstruct = true
csharp_style_pattern_matching_over_as_with_null_check = true
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_inlined_variable_declaration = true
csharp_prefer_index_operator = true
csharp_prefer_range_operator = true

# Tuple names
dotnet_style_explicit_tuple_names = true

# Accessibility modifiers (SA1401 - file must have single type)
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# === StyleCop Conflicts Resolution ===
# SA1101 (PrefixLocalCallsWithThis) is SUPPRESSED in Directory.Build.targets
# Disable IDE enforcement to avoid conflict
csharp_style_qualification_for_field = false:suggestion
csharp_style_qualification_for_property = false:suggestion
csharp_style_qualification_for_method = false:suggestion
csharp_style_qualification_for_event = false:suggestion
csharp_style_this_for_constructors = false:suggestion
csharp_style_this_for_methods = false:suggestion
csharp_style_this_for_indexers = false:suggestion
csharp_style_this_for_properties = false:suggestion
csharp_style_this_for_static_fields = false:suggestion
csharp_style_this_for_static_properties = false:suggestion
csharp_style_this_for_static_methods = false:suggestion
csharp_style_this_for_static_events = false:suggestion

# === Expression-bodied member preferences (explicit) ===
csharp_style_expression_bodied_lambdas = true
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_methods = true
csharp_style_expression_bodied_constructors = true
csharp_style_expression_bodied_operators = true
csharp_style_expression_bodied_accessors = true

# === Code Analysis Severity Overrides ===
# Suppressed in Directory.Build.targets - set to 'none' to silence in IDE
dotnet_diagnostic.SA1636.severity = none
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1127.severity = none
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1313.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.CA1040.severity = none
dotnet_diagnostic.CA1721.severity = none
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1513.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1625.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1131.severity = none
dotnet_diagnostic.CA1508.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.SA1000.severity = none

# Non-suppressed CA rules - adjust severity as needed
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.CA2007.severity = suggestion
dotnet_diagnostic.IDE0051.severity = suggestion
dotnet_diagnostic.IDE0052.severity = suggestion
dotnet_diagnostic.IDE0059.severity = suggestion

# === Formatting Rules (align with StyleCop layout) ===
# New lines
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left

# Spacing (SA10xx rules)
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false

# Braces (SA15xx)
csharp_new_line_before_open_brace = all

# Using directives (SA12xx)
csharp_using_directive_placement = outside_namespace
csharp_prefer_system_usings_first = true

[*.{csproj,props,targets}]
indent_size = 2

# Generated files - disable all analysis
[*.generated.cs]
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.CA1062.severity = none

# Test files - relaxed rules
[*/Tests/*.cs]
dotnet_diagnostic.CA1034.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1812.severity = none