FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Copy Directory.Build.props for shared properties
COPY ["Directory.Build.props", "."]
COPY ["Directory.Build.targets", "."]

# Copy project files preserving directory structure
COPY ["src/Core/Domain/Tfs.Portfolio.Domain.csproj", "src/Core/Domain/"]
COPY ["src/Core/Application/Tfs.Portfolio.Application.csproj", "src/Core/Application/"]
COPY ["src/Infrastructure/Persistence/Tfs.Portfolio.Infrastructure.Persistence.csproj", "src/Infrastructure/Persistence/"]
COPY ["src/Presentation/WebAPI/Tfs.Portfolio.Api.csproj", "src/Presentation/WebAPI/"]
COPY ["test/UnitTests/Tfs.Portfolio.UnitTests.csproj", "test/UnitTests/"]
COPY ["test/IntegrationTests/Tfs.Portfolio.IntegrationTests.csproj", "test/IntegrationTests/"]

# Restore dependencies for each project individually
RUN dotnet restore "src/Core/Domain/Tfs.Portfolio.Domain.csproj"
RUN dotnet restore "src/Core/Application/Tfs.Portfolio.Application.csproj"
RUN dotnet restore "src/Infrastructure/Persistence/Tfs.Portfolio.Infrastructure.Persistence.csproj"
RUN dotnet restore "src/Presentation/WebAPI/Tfs.Portfolio.Api.csproj"
RUN dotnet restore "test/UnitTests/Tfs.Portfolio.UnitTests.csproj"
RUN dotnet restore "test/IntegrationTests/Tfs.Portfolio.IntegrationTests.csproj"

# Copy source code
COPY . .

# Build the project
WORKDIR /src/test/IntegrationTests
RUN dotnet build "Tfs.Portfolio.IntegrationTests.csproj" --no-restore --verbosity normal

# Run shell for debugging
CMD ["sh"]
